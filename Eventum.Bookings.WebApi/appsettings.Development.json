{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ServiceName": "bookings-service",
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "BookingsConnection": "Host=localhost;Port=5435;Database=bookings;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-here-and-it-should-be-more-than-256-bit",
    "Issuer": "Eventum",
    "Audience": "Eventum",
    "ExpirationMinutes": 15
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  }
}
